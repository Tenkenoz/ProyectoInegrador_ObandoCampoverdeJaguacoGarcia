NODE_ENV=development

PORT=3001

CORS_ORIGINS=http://localhost:3000

# Only configure when a trusted proxy or gateway exists
TRUST_PROXY=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=user_app
DB_PASSWORD=User_DB_2026.Change.This.Password
DB_DATABASE=user_db

DB_SSL=false

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_BLOCK_MS=60000


# RS256 signing keys. Generate them with: pnpm keys:generate
JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem
JWT_KEY_ID=
JWT_EXPIRES_IN_SECONDS=900
JWT_ISSUER=secure-chat-auth
JWT_AUDIENCE=secure-chat-api
JWT_CLOCK_TOLERANCE_SECONDS=5